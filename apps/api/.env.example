NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://vizaje:vizaje@localhost:5432/vizaje_staff
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
PHOTO_STORAGE_DRIVER=local
PHOTO_STORAGE_PATH=./.data/photos
PHOTO_MAX_BYTES=10485760
PHOTO_MAX_DIMENSION=8192
PHOTO_MAX_PIXELS=25000000
# Required when PHOTO_STORAGE_DRIVER=s3 (and in production).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=vizaje-staff-photos
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_FORCE_PATH_STYLE=true
# Optional Expo access token for the push provider. Keep it outside source control.
# EXPO_PUSH_ACCESS_TOKEN=replace-me
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_WORKER_MAX_ATTEMPTS=6
NOTIFICATION_WORKER_POLL_MS=5000
