# Required API origin. The mobile client does not fall back to localhost.
# iOS Simulator: http://127.0.0.1:3000
# Android Emulator: http://10.0.2.2:3000
# Physical device or staging: use a reachable HTTPS origin, for example
# https://staging-api.example.com (do not use localhost or a production secret).
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Optional public base for one-time activation links. Use the same value in
# Admin; leave empty to keep only the vizaje://activate development fallback.
# Example: https://staff.example.com/activate
EXPO_PUBLIC_ACTIVATION_LINK_BASE_URL=
